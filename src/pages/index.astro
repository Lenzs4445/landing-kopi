---
// index.astro - Landing Page Kedai Kopi
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kopi Ruang Rekan - Kopi Pilihan Sepenuh Hati</title>
  
  <!-- Script CDN Tailwind wajib pakai is:inline di Astro -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-[#faf8f5] text-stone-800 antialiased">

  <!-- NAVBAR -->
  <nav class="sticky top-0 z-50 bg-[#faf8f5]/90 backdrop-blur-md border-b border-amber-900/10 px-6 py-4">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="text-2xl">☕</span>
        <span class="font-bold text-xl tracking-tight text-amber-950">RuangRekan<span class="text-amber-600">.coffee</span></span>
      </div>
      <div class="hidden md:flex gap-8 text-sm font-semibold text-stone-600">
        <a href="#tentang" class="hover:text-amber-700 transition">Tentang</a>
        <a href="#menu" class="hover:text-amber-700 transition">Menu Favorit</a>
        <a href="#lokasi" class="hover:text-amber-700 transition">Lokasi</a>
      </div>
      <a href="https://wa.me/6281234567890?text=Halo%20RuangRekan,%20saya%20mau%20pesan%20kopi" target="_blank" class="bg-amber-800 hover:bg-amber-900 text-white font-semibold px-5 py-2.5 rounded-full text-sm transition shadow-sm hover:shadow">
        Pesan Via WA
      </a>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-2 gap-12 items-center">
    <div>
      <span class="inline-block bg-amber-100 text-amber-900 text-xs font-bold px-3.5 py-1.5 rounded-full mb-4 uppercase tracking-wider">
        ✨ Freshly Brewed Daily
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold text-stone-900 leading-tight mb-6">
        Kopi Lokal Pilihan, Diseduh <span class="text-amber-700">Sepenuh Hati</span>.
      </h1>
      <p class="text-stone-600 text-lg mb-8 leading-relaxed">
        Nikmati racikan biji kopi Nusantara kualitas terbaik dengan suasana hangat. Cocok buat nemenin kerja, nongkrong, atau sekadar rehat sejenak.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#menu" class="bg-amber-800 hover:bg-amber-900 text-white font-bold px-7 py-3.5 rounded-full text-center transition shadow-lg shadow-amber-900/20">
          Lihat Menu Utama
        </a>
        <a href="#lokasi" class="border border-stone-300 hover:border-amber-800 text-stone-800 font-bold px-7 py-3.5 rounded-full text-center transition">
          Kunjungi Kedai
        </a>
      </div>
      <div class="mt-10 flex items-center gap-6 text-sm text-stone-500 font-medium border-t border-stone-200 pt-6">
        <div>⚡ <strong class="text-stone-800">100%</strong> Biji Arabika & Robusta</div>
        <div>⭐️ <strong class="text-stone-800">4.9/5</strong> (500+ Ulasan)</div>
      </div>
    </div>
    <div class="relative">
      <div class="aspect-square bg-amber-900/5 rounded-3xl overflow-hidden shadow-2xl border border-amber-900/10 flex items-center justify-center p-8 text-center bg-gradient-to-br from-amber-900/10 to-amber-800/20">
        <div class="space-y-4">
          <div class="text-8xl">☕️</div>
          <p class="font-bold text-amber-950 text-xl">Kopi Susu Gula Aren Signature</p>
          <span class="inline-block bg-white text-amber-900 font-extrabold text-sm px-4 py-1.5 rounded-full shadow-sm">
            Best Seller #1
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES / KEUNGGULAN -->
  <section id="tentang" class="bg-stone-900 text-stone-100 py-16 md:py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-3xl font-bold mb-4">Kenapa Ruang Rekan?</h2>
        <p class="text-stone-400">Kami percaya setiap tegukan kopi punya cerita dan kenyamanan tersendiri.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-stone-800/60 p-8 rounded-2xl border border-stone-700/50">
          <div class="text-3xl mb-4">🌱</div>
          <h3 class="text-xl font-bold mb-2 text-amber-400">Biji Kopi Petani Lokal</h3>
          <p class="text-stone-400 text-sm leading-relaxed">Dipetik langsung dari petani lokal berdedikasi tinggi dengan proses *roasting* yang konsisten.</p>
        </div>
        <div class="bg-stone-800/60 p-8 rounded-2xl border border-stone-700/50">
          <div class="text-3xl mb-4">🔌</div>
          <h3 class="text-xl font-bold mb-2 text-amber-400">Wi-Fi & Stopkontak Banyak</h3>
          <p class="text-stone-400 text-sm leading-relaxed">Tempat nyaman dan tenang yang ramah buat kamu yang mau *Work From Cafe* atau nugas sekolah.</p>
        </div>
        <div class="bg-stone-800/60 p-8 rounded-2xl border border-stone-700/50">
          <div class="text-3xl mb-4">🥐</div>
          <h3 class="text-xl font-bold mb-2 text-amber-400">Camilan Pendamping Segar</h3>
          <p class="text-stone-400 text-sm leading-relaxed">Aneka pastry dan roti manis yang dipanggang setiap pagi untuk melengkapi harimu.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MENU FAVORIT -->
  <section id="menu" class="max-w-6xl mx-auto px-6 py-20">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
      <div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-stone-900">Menu Andalan Kami</h2>
        <p class="text-stone-600 mt-2">Dibuat dari bahan-bahan segar setiap harinya.</p>
      </div>
      <span class="text-xs font-bold bg-amber-100 text-amber-900 px-3 py-1.5 rounded-full">Daftar Harga Terbaru</span>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Item 1 -->
      <div class="bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm hover:shadow-md transition">
        <div class="text-4xl mb-4">🧋</div>
        <h3 class="font-bold text-lg text-stone-900">Kopi Susu Ruang Rekan</h3>
        <p class="text-stone-500 text-sm my-2">Espresso, susu segar, dan gula aren organik spesial.</p>
        <div class="flex justify-between items-center mt-6 pt-4 border-t border-stone-100">
          <span class="font-extrabold text-amber-900 text-lg">Rp 18.000</span>
          <a href="https://wa.me/6281234567890?text=Saya%20mau%20pesan%20Kopi%20Susu%20Ruang%20Rekan" target="_blank" class="text-xs font-bold text-amber-800 hover:text-amber-950 bg-amber-50 px-3 py-2 rounded-lg">Pesan WA →</a>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm hover:shadow-md transition">
        <div class="text-4xl mb-4">☕️</div>
        <h3 class="font-bold text-lg text-stone-900">Americano Classic</h3>
        <p class="text-stone-500 text-sm my-2">Double shot espresso dengan ekstraksi sempurna.</p>
        <div class="flex justify-between items-center mt-6 pt-4 border-t border-stone-100">
          <span class="font-extrabold text-amber-900 text-lg">Rp 15.000</span>
          <a href="https://wa.me/6281234567890?text=Saya%20mau%20pesan%20Americano%20Classic" target="_blank" class="text-xs font-bold text-amber-800 hover:text-amber-950 bg-amber-50 px-3 py-2 rounded-lg">Pesan WA →</a>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm hover:shadow-md transition">
        <div class="text-4xl mb-4">🍵</div>
        <h3 class="font-bold text-lg text-stone-900">Creamy Matcha Latte</h3>
        <p class="text-stone-500 text-sm my-2">Matcha Uji Jepang asli dipadukan dengan susu segar.</p>
        <div class="flex justify-between items-center mt-6 pt-4 border-t border-stone-100">
          <span class="font-extrabold text-amber-900 text-lg">Rp 22.000</span>
          <a href="https://wa.me/6281234567890?text=Saya%20mau%20pesan%20Creamy%20Matcha" target="_blank" class="text-xs font-bold text-amber-800 hover:text-amber-950 bg-amber-50 px-3 py-2 rounded-lg">Pesan WA →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- LOKASI & CTA -->
  <section id="lokasi" class="bg-amber-950 text-amber-50 py-16 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-extrabold mb-4">Mampir ke Kedai Kami</h2>
      <p class="text-amber-200/80 mb-8 max-w-lg mx-auto">
        Jl. Pemuda No. 45, Kota Kamu (Buka Setiap Hari: 08.00 - 22.00 WIB)
      </p>
      <a href="https://wa.me/6281234567890?text=Halo,%20saya%20mau%20tanya%20lokasi%20kedai" target="_blank" class="inline-block bg-amber-500 hover:bg-amber-400 text-amber-950 font-extrabold px-8 py-4 rounded-full transition shadow-lg">
        Hubungi Kasir via WhatsApp 📲
      </a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-stone-900 text-stone-500 py-8 px-6 text-center text-xs">
    <p>© 2026 Ruang Rekan Coffee. Built with Astro & Vercel.</p>
  </footer>

</body>
</html>